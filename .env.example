# FastAPI Backend Server Configuration
PORT=8000
HOST=0.0.0.0
DEFAULT_NEURAL_VOICE=en-US-AvaMultilingualNeural

# Mobile App Default Backend URL (Update to your PC's LAN IP when testing on physical phone)
