# Optional Cloud TTS API Keys (Can also be entered directly inside the Mobile App Settings UI)
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
